# Telegram: crea un bot con @BotFather e ottieni chat_id con @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# --- Filtri prodotto ---
# Valore minimo mostrato sotto l'annuncio (€)
MIN_RETAIL_VALUE=50

# Risparmio minimo nominale: valore - prezzo_asta (€)
MIN_SAVINGS_EUR=30

# Soglie % prezzo rispetto al valore (tier)
HIGH_VALUE_THRESHOLD=100
MAX_PRICE_RATIO_HIGH=0.15
MAX_PRICE_RATIO_MID=0.25
MAX_PRICE_RATIO=0.35

# Stima costo singola puntata per il messaggio Telegram (€)
BID_COST_ESTIMATE=0.20

# Pattern extra da escludere (regex separate da virgola)
# EXCLUDE_PATTERNS=lotteria,estrazione

# --- Modalità ---
# radar = timer fino a 5 min (GitHub Actions / controllo ogni 5 min)
# snipe  = timer fino a 60 s (PC acceso, poll rapido)
MONITOR_MODE=radar

# Considera "sta per chiudersi" se mancano al massimo N secondi
# (default: 300 in radar, 60 in snipe)
MAX_TIMER_SECONDS=300

# Intervallo loop continuo (default: 30 radar, 15 snipe)
POLL_INTERVAL=30

# Per automazione ogni 5 minuti: python monitor.py --once

# Non reinviare lo stesso alert per la stessa asta prima di N secondi
ALERT_COOLDOWN=600

# Pagina/categoria da monitorare
BIDOO_URL=https://it.bidoo.com/
# BIDOO_URL=https://it.bidoo.com/?tag=smartphone
# BIDOO_URL=https://it.bidoo.com/?tag=elettrodomestici

# Playwright (solo se Bidoo risponde 403)
# BIDOO_USE_PLAYWRIGHT=true
