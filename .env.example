# Telegram: crea un bot con @BotFather e ottieni chat_id con @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# --- Categorie (vuoto = solo 4 categorie poco battute) ---
# prima-infanzia, animali_domestici, sport, casa
# RESALE_CATEGORIES=prima-infanzia,sport

BIDOO_BASE_URL=https://it.bidoo.com/

# --- Filtri rigidi (meno notifiche, solo occasioni vere) ---
MIN_RETAIL_VALUE=40
MIN_RESALE_PROFIT_EUR=25
MIN_RESALE_MARGIN_PCT=25
MIN_RESALE_SCORE=50

# Stima rivendita live: solo fonti eBay/Vinted (non aste giudiziarie/bancali)
MARKET_LOOKUP=true
MARKET_LOOKUP_SOURCES=ebay_source,vinted_source
MARKET_CACHE_HOURS=24
MARKET_LOOKUP_DELAY_S=0.35
MARKET_MIN_VINTED_SAMPLES=2
MARKET_MIN_EBAY_SAMPLES=2
MIN_PRICE_HEADROOM_EUR=0.50
BID_COST_ESTIMATE=0.20
SHIPPING_COST_EUR=8

# --- Tipi alert (default: solo deal) ---
# deal  = margine sopra soglia (consigliato)
# quiet = anche aste tranquille con margine (più notifiche)
# new   = anche aste appena viste (molte notifiche, sconsigliato)
ALERT_KINDS=deal

# Asta tranquilla: osservazioni minime e poco movimento prezzo
QUIET_MIN_OBSERVATIONS=3
QUIET_MAX_PRICE_DELTA_CENTS=8

HISTORY_MAX_AGE_HOURS=72

# Non reinviare alert per la stessa asta prima di N secondi (3600 = 1 ora)
ALERT_COOLDOWN=3600

POLL_INTERVAL=300

# Per automazione ogni 5 minuti: python monitor.py --once

# EXCLUDE_PATTERNS=lotteria,estrazione

# Playwright (Bidoo / Catawiki / Gobid se 403)
# BIDOO_USE_PLAYWRIGHT=true
# USE_PLAYWRIGHT=true

# --- Multi-sito (monitor_all.py) ---
# Default senza login: prezzishock,antiebay,industrial_discount,surplex
# Aggiungi: catawiki,astagiudiziaria,gobid,bstock,merkandi,stocklots24,ebay_source
ENABLED_SOURCES=prezzishock,astegiudiziarie,catawiki,gobid,astagiudiziaria,industrial_discount,remundo,ebay_source
INCLUDE_BIDOO=false
CLASSIC_SKIP_HYPER=true
SKIP_HEAVY_ITEMS=true
USE_PLAYWRIGHT=true
PLAYWRIGHT_HEADED=true
# Profilo Chrome locale: cookie Akamai salvati tra un run e l'altro (.playwright-profile/)
PLAYWRIGHT_PERSISTENT_PROFILE=true
# Secondi max per captcha a mano su siti Akamai (Catawiki/Gobid). Remundo usa solo JSON, no Playwright.
PLAYWRIGHT_CHALLENGE_WAIT_MS=600000
# Remundo: timeout HTTP JSON (default 60s). Se non risponde entro, salta e passa alla fonte dopo.
# REMUNDO_FETCH_TIMEOUT=60
# API JSON generiche: no fallback Playwright (carica subito o errore). Remundo/Shopify non ne hanno bisogno.
# JSON_USE_PLAYWRIGHT=false
# PLAYWRIGHT_USER_DATA_DIR=C:\Users\TUO\playwright-profile

# --- Database unico (SQLite) ---
USE_DATABASE=true
# DATABASE_PATH=data/monitor.db

# Simula ingestione/stima/alert senza Telegram né scritture DB produzione
# DRY_RUN=false

# --- Anti-bot / proxy ---
# ROTATING_PROXY_URL=http://user:pass@host:port
# FLARESOLVERR_URL=http://localhost:8191
# USE_PLAYWRIGHT_ON_GITHUB=true

# --- ROI dinamico (sostituisce cap rigido MAX_PALLET_EUR per gli alert) ---
USE_DYNAMIC_ROI=true
MIN_NET_ROI_PCT=35
MIN_EXPECTED_PROFIT_EUR=50

# --- Vision AI (Gemini Flash) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
VISION_ANALYSIS=true

# --- Telegram inline feedback + ops ---
TELEGRAM_INLINE_KEYBOARD=true
# TELEGRAM_DEV_CHAT_ID=          # alert scraper (default = TELEGRAM_CHAT_ID)
# SCRAPER_FAIL_ALERT_THRESHOLD=3
# Avvia bot: python telegram_bot.py  (/stats /pause /force_sync)

# --- Backup database ---
BACKUP_TARGETS=telegram
# BACKUP_AFTER_SYNC=true
# TELEGRAM_BACKUP_CHAT_ID=
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=

# --- Spedizione dinamica e bidding velocity ---
USE_SHIPPING_MATRIX=true
BIDDING_VELOCITY_WINDOW_MIN=30
BIDDING_VELOCITY_HOT_PER_HOUR=6
BIDDING_VELOCITY_CONFIDENCE_PENALTY=20

# --- Smart polling (2 velocità) ---
MONITOR_MODE=discovery
# discovery = catalogo ogni 2h (consigliato Windows) | full = alert + catalogo | sniper = solo lotti in chiusura
SNIPER_WINDOW_HOURS=2
DISCOVERY_INTERVAL_HOURS=2
CATALOG_MAX_AGE_HOURS=168

# --- Semantic comps ---
SEMANTIC_COMPS=true
SEMANTIC_COMPS_THRESHOLD=0.72
# GEMINI_EMBED_MODEL=text-embedding-004

# Aste classiche: solo quelle che chiudono entro N ore (4 = prossime 3–4 ore).
# Aste giudiziarie: 24h (chiudono più lente). Bancali Remundo: nessun filtro.
# Finestra aste in chiusura: allineata al cooldown scrape (default 8h)
SCRAPE_COOLDOWN_HOURS=8
MAX_HOURS_TO_END=8
MAX_HOURS_TO_END_JUDICIAL=24

CATAWIKI_QUERIES=casio,garmin,fossil,seiko,lego,profumo,sneaker nike,borsa,makita,kenwood,xiaomi,lampada,chicco
CATAWIKI_CLOSING_TODAY=true
CATAWIKI_USE_CATEGORIES=true
# Categorie reali (non usare /c/293-orologi: 404). Override opzionale:
# CATAWIKI_CATEGORY_URLS=https://www.catawiki.com/it/c/333-orologi-da-polso,https://www.catawiki.com/it/c/721-moda
# MAX_HOURS_TO_END_CATAWIKI=24

# Astagiudiziaria: ricerca /ricerca/mobili con data vendita dinamica (Europe/Rome).
# 0 = solo oggi; 1 = oggi+domani (default); 2 = fino a dopodomani.
ASTAGIUDIZIARIA_DAYS_AHEAD=1
# ASTAGIUDIZIARIA_PAGES=3
# ASTAGIUDIZIARIA_RPP=50
# Categorie separate da | (senza auto). Override URL complete: ASTAGIUDIZIARIA_URLS=...
# ASTAGIUDIZIARIA_CATEGORIES=ARTE -OREFICERIA - OROLOGERIA- ANTIQUARIATO|INFORMATICA E ELETTRONICA|ABBIGLIAMENTO E CALZATURE

# astegiudiziarie.it: filtro API dataVendita PRIMA degli XML (veloce).
# 0 = solo oggi (default); 1 = oggi+domani.
ASTEGIUDIZIARIE_DAYS_AHEAD=0
# ASTEGIUDIZIARIE_MAX_LOTS=40
# ASTEGIUDIZIARIE_MAX_EUR=400
# ASTEGIUDIZIARIE_XML_WORKERS=6

# Astegiudiziarie.it: 9=elettronica 11=orologi/arte 12=abbigliamento (6=veicoli)
# ASTEGIUDIZIARIE_TIPOLOGIE=9,11,12
# ASTEGIUDIZIARIE_MAX_EUR=400

# Ricerche fonti classificate / eBay HTML
# WALLAPOP_QUERIES=casio,garmin,makita,xiaomi,lego,kenwood
# VINTED_SOURCE_QUERIES=casio,garmin,lego,nike,dyson
# SUBITO_QUERIES=casio,makita,garmin,lego,xiaomi
# eBay → rivendita Vinted (Browse API OAuth)
# EBAY_APP_ID=YourAppId-PRD-xxxxx
# EBAY_DEV_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# EBAY_CERT_ID=PRD-xxxxxxxx-xxxx-xxxx-xxxx
# EBAY_GLOBAL_ID=EBAY-IT
# EBAY_SOURCE_KEYWORDS=casio g-shock,garmin orologio,lego,nike sneaker,nintendo switch
# EBAY_MAX_PRICE=120
# EBAY_MIN_PRICE=5
# EBAY_RESULTS_PER_QUERY=30
# MAX_HOURS_TO_END_EBAY=8

# B-Stock (catalogo pallet dopo login)
# BSTOCK_EMAIL=
# BSTOCK_PASSWORD=

# Merkandi (abbonamento a pagamento)
# MERKANDI_EMAIL=
# MERKANDI_PASSWORD=

# Stocklots24
# STOCKLOTS24_EMAIL=
# STOCKLOTS24_PASSWORD=

# Catawiki: ricerche (opzionale)
# CATAWIKI_QUERIES=orologio,borsa,sneaker,profumo

# --- Budget / all-in ---
# Tetto spesa = min(budget da score, 40% del valore ufficiale/Amazon-like)
MAX_BUY_OF_OFFICIAL_PCT=40
MAX_PALLET_EUR=400
MAX_COST_PER_PIECE_EUR=15
GOBID_DEPOSIT_EUR=50
JUDICIAL_DEPOSIT_EUR=30
PICKUP_COST_EUR=35

# Score 50 → max 40 € | 70 → 60 € | 90 → 100 €; moda Vinted 5–25 €

# --- Allocazione capitale / portafoglio ---
# MAX_ACTIVE_CAPITAL_EUR=2000
# MAX_CATEGORY_EXPOSURE_PCT=50
# MAX_UNTESTED_CATEGORY_EXPOSURE_PCT=30
# UNTESTED_CATEGORIES=elettronica,smartwatch,utensili
# MAX_BRAND_EXPOSURE_PCT=25
# CAPITAL_ALLOCATOR=true

# --- Lot unbundler + listing generator ---
# LOT_UNBUNDLER=true

# --- Proxy health (failover per dominio) ---
# PROXY_HEALTH=true
# ROTATING_PROXY_URL_ALT=http://user:pass@proxy-alt:port
# PROXY_SLOW_MS=8000

# --- Repricing inventario (job settimanale) ---
# REPRICER_STALE_DAYS=14
# REPRICER_CRITICAL_DAYS=30
# REPRICER_STALE_MARKDOWN_PCT=10
# REPRICER_MARKET_DROP_MARKDOWN_PCT=12
# REPRICER_MARKET_DROP_THRESHOLD_PCT=8

# --- eBay Sell API (pubblicazione diretta) ---
# EBAY_USER_REFRESH_TOKEN=your_refresh_token
# EBAY_MERCHANT_LOCATION_KEY=your_location_key
# EBAY_FULFILLMENT_POLICY_ID=
# EBAY_PAYMENT_POLICY_ID=
# EBAY_RETURN_POLICY_ID=
# EBAY_DEFAULT_CATEGORY_ID=9355
# EBAY_DEFAULT_CONDITION=USED_EXCELLENT
# EBAY_AUTO_PUBLISH=false

# --- Report fiscale ---
# TAX_REGIME=forfettario
# TAX_FORFETTARIO_RATE=0.15
# TAX_FORFETTARIO_COEFF=0.78
# TAX_MARGINE_IVA_RATE=0.22
# TAX_ORDINARIO_RATE=0.24
# TAX_REPORT_DIR=data/reports

# --- Telegram multi-topic (supergruppo forum) ---
# TELEGRAM_TOPICS_ENABLED=true
# TELEGRAM_TOPIC_ELECTRONICS=2
# TELEGRAM_TOPIC_PALLET=3
# TELEGRAM_TOPIC_RISKY=4
# TELEGRAM_TOPIC_FASHION=5
# TELEGRAM_TOPIC_INVENTORY=6
# TELEGRAM_TOPIC_REPRICING=7
# TELEGRAM_TOPIC_TAX=8
# TELEGRAM_TOPIC_OPS=9
# TELEGRAM_TOPIC_DEFAULT=1
# TELEGRAM_TOPIC_ELECTRONICS_MIN_CONFIDENCE=70
# TELEGRAM_TOPIC_RISKY_CONFIDENCE=55

# Fetch: retry HTTP + Playwright se 403/challenge
# FETCH_RETRIES=3
# PLAYWRIGHT_WAIT_MS=4500
# PLAYWRIGHT_GOTO_MS=35000
# COMPS_PRODUCTS=casio,makita,nike,lego
# COMPS_DELAY_S=1.4
