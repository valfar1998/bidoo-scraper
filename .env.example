# Telegram: crea un bot con @BotFather e ottieni chat_id con @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Valore minimo del prodotto (€) mostrato sotto l'annuncio
MIN_RETAIL_VALUE=10

# Avvisa se il prezzo d'asta è sotto questa % del valore (0.35 = 35%)
MAX_PRICE_RATIO=0.35

# Considera "sta per chiudersi" se mancano al massimo N secondi al timer
MAX_TIMER_SECONDS=300

# Intervallo tra un controllo e l'altro (secondi) - solo se avvii senza --once
POLL_INTERVAL=15

# Per automazione ogni 5 minuti usa: python monitor.py --once
# (non serve cambiare POLL_INTERVAL)

# Non reinviare lo stesso alert per la stessa asta prima di N secondi
ALERT_COOLDOWN=600

# URL pagina aste (puoi aggiungere ?tag=smartphone ecc.)
BIDOO_URL=https://it.bidoo.com/
